generator client {
  provider = "prisma-client-js"
  output   = "../prisma-principal/principal-database-client-types"
}

datasource db {
  provider = "postgresql"
  url      = env("PRINCIPAL_DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @map("email")
  createdAt DateTime @default(now()) @map("created_at")

  userCredentials UserCredentials[]
  userCompanies   UserCompany[]

  @@map("user")
}

model UserCredentials {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  hashedPassword String   @map("hashed_password")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credential")
}

model UserCompany {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@map("user_company")
}

model CompanyBranding {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @unique @map("company_id") @db.Uuid
  logo           String?  @map("logo")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  tertiaryColor  String?  @map("tertiary_color")
  createdAt      DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("company_branding")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @map("name")
  dbName    String   @unique @map("db_name")
  statusId  String   @map("status_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  companyUsers    UserCompany[]
  companyBranding CompanyBranding[]
  paymentInfo     PaymentInfo[]
  status          Status            @relation(fields: [statusId], references: [id], onDelete: Restrict)

  @@map("company")
}

model PaymentInfo {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phoneNumber String   @map("phone_number")
  address     String   @map("address")
  description String   @map("description")
  statusId    String   @map("status_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status  Status  @relation(fields: [statusId], references: [id], onDelete: Restrict)

  @@map("payment_info")
}

model Status {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @map("name")
  createdAt DateTime @default(now()) @map("created_at")

  company     Company[]
  PaymentInfo PaymentInfo[]

  @@map("status")
}
