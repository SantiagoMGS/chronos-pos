generator client {
  provider = "prisma-client-js"
  output   = "../prisma-tenant-base/tenant-database-client-types"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_BASE_DATABASE_URL")
}

model TenantMigration {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tenant_migration")
}

model Application {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @map("name")
  description String? @map("description")
  icon        String  @map("icon")
  path        String  @unique @map("path")

  resources Resource[]

  @@map("application")
}

model Resource {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique @map("name")
  description   String? @map("description")
  icon          String  @map("icon")
  path          String  @unique @map("path")
  applicationId String? @map("application_id") @db.Uuid
  parentId      String? @map("parent_id") @db.Uuid

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  parent      Resource?    @relation("ParentResource", fields: [parentId], references: [id], onDelete: Restrict)
  children    Resource[]   @relation("ParentResource")
  actions     Action[]

  @@unique([name, applicationId])
  @@unique([name, parentId])
  @@map("resource")
}

model Action {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @map("name")
  description String? @map("description")
  resourceId  String  @map("resource_id") @db.Uuid

  resource    Resource     @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  roleActions RoleAction[]

  @@map("action")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  isActive    Boolean  @default(true) @map("is_active")

  roleActions RoleAction[]
  userRoles   UserRole[]

  @@map("role")
}

model RoleAction {
  roleId   String @map("role_id") @db.Uuid
  actionId String @map("action_id") @db.Uuid

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  action Action @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@id([roleId, actionId])
  @@map("role_action")
}

model UserRole {
  userId   String  @map("user_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}

model UserInfo {
  userId         String       @map("user_id") @db.Uuid
  name           String       @map("name")
  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number")

  @@id([userId])
  @@map("user_info")
}

enum DocumentType {
  CEDULA_DE_CIUDADANIA
  TARJETA_DE_IDENTIDAD
  CEDULA_DE_EXTRANJERIA
  NIT
}

model Country {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @map("name")

  departments Department[]

  @@map("country")
}

model Department {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique @map("name")
  daneCode  String  @unique @map("dane_code")
  countryId String  @map("country_id") @db.Uuid
  isActive  Boolean @default(true) @map("is_active")

  cities  City[]
  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@index([name])
  @@map("department")
}

model City {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @map("name")
  daneCode     String  @map("dane_code")
  departmentId String  @map("department_id") @db.Uuid
  isActive     Boolean @default(true) @map("is_active")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([name, daneCode, departmentId])
  @@index([name])
  @@map("city")
}

model MeasurementUnit {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @map("code")
  name String @unique @map("name")

  items Item[]

  @@map("measurement_unit")
}

enum ItemType {
  PRODUCTO
  SERVICIO
}

model Item {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @map("name")
  code        String   @unique @map("code")
  price       Decimal  @map("price")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  itemType    ItemType @map("item_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  measurementUnitId String          @map("measurement_unit_id") @db.Uuid
  measurementUnit   MeasurementUnit @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict)

  @@map("item")
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @map("name")
  documentType   DocumentType @map("document_type")
  documentNumber String       @unique @map("document_number")

  email       String  @map("email")
  phoneNumber String  @map("phone_number")
  isActive    Boolean @default(true) @map("is_active")

  @@map("customer")
}
